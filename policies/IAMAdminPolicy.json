{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Action": [
                "iam:CreatePolicy",
                "iam:CreatePolicyVersion",
                "iam:PutRolePolicy",
                "iam:PutUserPolicy",
                "iam:DeletePolicy",
                "iam:AttachUserPolicy",
                "iam:DetachUserPolicy",
                "iam:AttachRolePolicy",
                "iam:DetachRolePolicy"
            ],
            "Resource": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/AuthLambdaRole",
            "Condition": {
                "StringEquals": {
                    "aws:RequestedBy": "arn:aws:iam::${AWS_ACCOUNT_ID}:user/DeploymentUser"
                }
            }
        }
    ]
}
