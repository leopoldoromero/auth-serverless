{
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Action": [
          "cloudformation:*",
          "s3:*",
          "iam:PassRole",
          "lambda:*",
          "apigateway:*",
          "dynamodb:*",
          "logs:*",
          "cognito-idp:*"
        ],
        "Resource": "*"
      }
    ]
  }
  